; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="cowboy-godot-project"
config/version="0.0.1"
run/main_scene="uid://ctk4q7q61sfy1"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=240
config/icon="res://icon.svg"

[autoload]

Global="*res://src/meta_layer/MainGame.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="cowboy-godot-project"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "green",
"res://assets/art/": "green",
"res://assets/sounds/": "blue",
"res://src/": "red",
"res://src/debug/": "yellow"
}

[gdunit4]

settings/test/test_timeout_seconds=30
settings/test/test_lookup_folder="tests"
settings/test/test_suite_naming_convention=1
settings/test/test_discovery=true
settings/test/flaky_check_enable=true
ui/inspector/tree_sort_mode=1
ui/toolbar/run_overall=true

